# Copy to .env and adjust for the deployment environment. No secrets are needed.
# Blank values use the safe local defaults in compose.yaml.
RAINSCOPE_HTTP_PORT=
RAINSCOPE_BIND_ADDRESS=
RAINSCOPE_ALLOWED_HOSTS=
RAINSCOPE_CORS_ORIGINS=
ECMWF_SOURCE=

# Optional build-time basemap overrides. Leave blank to use the documented
# OpenFreeMap style and its provider-supplied attribution.
VITE_API_BASE_URL=
VITE_BASEMAP_STYLE_URL=
VITE_BASEMAP_TILE_URL=
VITE_BASEMAP_ATTRIBUTION=
